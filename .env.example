# ---------------------------------------------------------------------------
# Gemini Search Agent — environment
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# `.env` is git-ignored; never commit a real key.
# ---------------------------------------------------------------------------

# Google Gemini API key. Required — the app refuses to start without it and
# tells you so.
#
# Get one free at https://aistudio.google.com/apikey
#
# GEMINI_API_KEY is also accepted, if you already have that set.
GOOGLE_API_KEY=your-key-here
